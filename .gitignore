# Root .gitignore for the TalentPulseAI monorepo.
# Subdirectories (Frontend/, TalentPulseAI-fastAPI/) keep their own .gitignore too.

# Secrets
.env
.env.*
!.env.example
# Mode files: they hold only an API base URL + timeout, no credentials, and which
# backend a build talks to must be reviewable in the diff — not per-machine state.
!.env.development
!.env.remote
!.env.production

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.coverage

# Node
node_modules/
dist/
.vite/

# OS / editor
.DS_Store
Thumbs.db
*.swp
