# DEPLOYED backend on Render — used by `npm run dev:remote`.
# The free instance sleeps after ~15 min idle and needs ~50-60s to wake, hence
# the raised timeout. This talks to the DEPLOYED database, so accounts you
# registered locally do NOT exist here.
VITE_API_BASE_URL=https://talentpulseai-api.onrender.com
VITE_API_URL=https://talentpulseai-api.onrender.com
VITE_API_TIMEOUT=90000
